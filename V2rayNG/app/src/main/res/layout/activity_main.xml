<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient">

    <!-- Progress / waiting indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_waiting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/color_fab_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Power button (top center) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_power"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="60dp"
        app:strokeColor="@color/my_neon_green"
        app:strokeWidth="2dp"
        android:backgroundTint="@color/color_fab_inactive"
        app:icon="@drawable/ic_play_24dp"
        app:iconSize="48dp"
        app:rippleColor="@color/my_neon_green"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Current server selector -->
    <TextView
        android:id="@+id/tv_current_server"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textStyle="normal"
        android:textSize="16sp"
        android:padding="12dp"
        android:gravity="center"
        android:drawablePadding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/btn_power"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_marginTop="16dp"
        android:text="Текущий сервер: - ▼" />

    <!-- VPN status indicator -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_current_server"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_marginTop="4dp"
        android:text="@string/connection_not_connected" />

    <!-- Bottom action buttons -->
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clipboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/menu_item_import_config_clipboard"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/my_neon_green"
            app:strokeWidth="1dp"
            app:rippleColor="@color/my_neon_green"
            android:backgroundTint="@android:color/transparent" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_subscription"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/add_subscription"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/my_neon_green"
            app:strokeWidth="1dp"
            app:rippleColor="@color/my_neon_green"
            android:backgroundTint="@android:color/transparent" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_qrcode"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/menu_item_import_config_qrcode"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/my_neon_green"
            app:strokeWidth="1dp"
            app:rippleColor="@color/my_neon_green"
            android:backgroundTint="@android:color/transparent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
